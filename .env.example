# AUTOVISION AI Configuration Template
# Duplicate this file as .env and fill in your actual credentials.

# -----------------------------------------------------------------------------
# Groq API Keys (Primary + Automatic Failover Backup)
# -----------------------------------------------------------------------------
# Vision providers are tried in VISION_PROVIDER_ORDER; the local ResNet-50 + EfficientNet-B0 classifier is the final fallback.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT=25
VISION_PROVIDER_ORDER=gemini,groq
VISION_CACHE_SIZE=64
VISION_CACHE_TTL=3600

GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_API_KEY_BACKUP=your_backup_groq_api_key_here

# -----------------------------------------------------------------------------
# Groq Vision & Verdict Models
# -----------------------------------------------------------------------------
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VERDICT_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT=20.0
GROQ_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Regional Market Valuation Defaults
# -----------------------------------------------------------------------------
DEFAULT_MARKET_REGION=India
DEFAULT_MARKET_CURRENCY=INR
ENABLE_VEHICLE_SPECIFICATIONS=true
ENABLE_MARKET_VALUATION=true

# -----------------------------------------------------------------------------
# Model & Detection Settings
# -----------------------------------------------------------------------------
DEFAULT_DETECTION_CONF=0.25
DEFAULT_EXTERIOR_CONF=0.20
CLASSIFIER_UNCERTAINTY_THRESHOLD=0.40
ENABLE_PREDICTION_COMPARISON=true

# -----------------------------------------------------------------------------
# Image optimisation, uploads, CORS, classifier
# -----------------------------------------------------------------------------
GROQ_IMAGE_MAX_DIM=1024
GROQ_IMAGE_JPEG_QUALITY=78
MAX_UPLOAD_BYTES=26214400
# Comma-separated origins allowed to call the API from a different host (not needed when FastAPI serves the UI)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLASSIFY_FULL_FRAME=true
CLASSIFIER_ENSEMBLE=true
