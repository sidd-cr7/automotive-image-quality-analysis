# AUTOVISION AI Configuration Template
# Duplicate this file as .env and fill in your actual credentials.

# -----------------------------------------------------------------------------
# Groq API Keys (Primary + Automatic Failover Backup)
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_API_KEY_BACKUP=your_backup_groq_api_key_here

# -----------------------------------------------------------------------------
# Groq Vision & Verdict Models
# -----------------------------------------------------------------------------
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_VERDICT_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=20.0
GROQ_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Regional Market Valuation Defaults
# -----------------------------------------------------------------------------
DEFAULT_MARKET_REGION=India
DEFAULT_MARKET_CURRENCY=INR
ENABLE_VEHICLE_SPECIFICATIONS=true
ENABLE_MARKET_VALUATION=true

# -----------------------------------------------------------------------------
# Model & Detection Settings
# -----------------------------------------------------------------------------
DEFAULT_DETECTION_CONF=0.25
DEFAULT_EXTERIOR_CONF=0.20
CLASSIFIER_UNCERTAINTY_THRESHOLD=0.40
ENABLE_PREDICTION_COMPARISON=true
